<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="MaxDefinitions" targetNamespace="https://kirocrew.dev/process/max">
  <bpmn:process id="MaxOwnerPairing" name="MAX owner pairing" isExecutable="false">
    <bpmn:documentation>Descriptive source implementation. Host owner issues a code through authenticated same-origin dashboard POST. TTL 300 seconds, five attempts, single use. First sender is never trusted. Atomic persistence precedes access. No live MAX demonstration or deployment is claimed. Work item it_fd9542a7; technical source work, no Plane card required.</bpmn:documentation>
    <bpmn:laneSet id="Roles">
      <bpmn:lane id="OwnerLane" name="Host owner"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Present</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="GatewayLane" name="Gateway"><bpmn:flowNodeRef>Host</bpmn:flowNodeRef><bpmn:flowNodeRef>Issue</bpmn:flowNodeRef><bpmn:flowNodeRef>Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Persist</bpmn:flowNodeRef><bpmn:flowNodeRef>Paired</bpmn:flowNodeRef><bpmn:flowNodeRef>Denied</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Pair request"/>
    <bpmn:userTask id="Request" name="Owner: dashboard POST"/>
    <bpmn:exclusiveGateway id="Host" name="Host owner?"/>
    <bpmn:serviceTask id="Issue" name="Gateway: issue code"/>
    <bpmn:userTask id="Present" name="Owner: private /start"/>
    <bpmn:exclusiveGateway id="Valid" name="Valid code?"/>
    <bpmn:serviceTask id="Persist" name="Gateway: save numeric ID"/>
    <bpmn:endEvent id="Paired" name="Paired"/>
    <bpmn:endEvent id="Denied" name="Denied"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Request" name=""/>
    <bpmn:sequenceFlow id="F2" sourceRef="Request" targetRef="Host" name=""/>
    <bpmn:sequenceFlow id="F3" sourceRef="Host" targetRef="Issue" name="yes"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Host" targetRef="Denied" name="no"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Issue" targetRef="Present" name=""/>
    <bpmn:sequenceFlow id="F6" sourceRef="Present" targetRef="Valid" name=""/>
    <bpmn:sequenceFlow id="F7" sourceRef="Valid" targetRef="Persist" name="yes"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Valid" targetRef="Denied" name="expired / wrong / used"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Persist" targetRef="Paired" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="MaxDiagram"><bpmndi:BPMNPlane id="MaxPlane" bpmnElement="MaxOwnerPairing">
    <bpmndi:BPMNShape id="DI_OwnerLane" bpmnElement="OwnerLane" isHorizontal="true"><dc:Bounds x="20" y="25" width="1230" height="130"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_GatewayLane" bpmnElement="GatewayLane" isHorizontal="true"><dc:Bounds x="20" y="155" width="1230" height="265"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Start" bpmnElement="Start"><dc:Bounds x="55" y="75" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Request" bpmnElement="Request"><dc:Bounds x="130" y="55" width="165" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Host" bpmnElement="Host"><dc:Bounds x="335" y="210" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Issue" bpmnElement="Issue"><dc:Bounds x="430" y="197" width="165" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Present" bpmnElement="Present"><dc:Bounds x="635" y="55" width="165" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Valid" bpmnElement="Valid"><dc:Bounds x="840" y="210" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Persist" bpmnElement="Persist"><dc:Bounds x="930" y="197" width="175" height="76"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Paired" bpmnElement="Paired"><dc:Bounds x="1160" y="217" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Denied" bpmnElement="Denied"><dc:Bounds x="700" y="355" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="DI_F1" bpmnElement="F1"><di:waypoint x="91" y="93"/><di:waypoint x="130" y="93"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F2" bpmnElement="F2"><di:waypoint x="295" y="93"/><di:waypoint x="360" y="93"/><di:waypoint x="360" y="210"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F3" bpmnElement="F3"><di:waypoint x="385" y="235"/><di:waypoint x="430" y="235"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F4" bpmnElement="F4"><di:waypoint x="360" y="260"/><di:waypoint x="360" y="373"/><di:waypoint x="700" y="373"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F5" bpmnElement="F5"><di:waypoint x="595" y="235"/><di:waypoint x="615" y="235"/><di:waypoint x="615" y="93"/><di:waypoint x="635" y="93"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F6" bpmnElement="F6"><di:waypoint x="800" y="93"/><di:waypoint x="865" y="93"/><di:waypoint x="865" y="210"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F7" bpmnElement="F7"><di:waypoint x="890" y="235"/><di:waypoint x="930" y="235"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F8" bpmnElement="F8"><di:waypoint x="865" y="260"/><di:waypoint x="865" y="373"/><di:waypoint x="736" y="373"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DI_F9" bpmnElement="F9"><di:waypoint x="1105" y="235"/><di:waypoint x="1160" y="235"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
