<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="MaxDefinitions" targetNamespace="https://kirocrew.dev/process/max">
  <bpmn:process id="MaxOwnerPairing" name="MAX owner pairing" isExecutable="false">
    <bpmn:documentation>Descriptive source implementation. In webhook mode, prerequisite: the host owner registers the configured HTTPS subscription using Settings / Channels / MAX / Register webhook. Registration success does not prove delivery. Then the host owner issues a code using Pair owner through authenticated same-origin dashboard POST. TTL 300 seconds, five attempts, single use. First sender is never trusted. Atomic persistence precedes access. Webhook controls consume their retry fingerprint before execution; after interruption send a new command rather than replay an old approval. Pairing and text reply were confirmed on testserver; max.4 navigation and tool permission were accepted by the owner. This is descriptive Python behavior, not a Camunda deployment. Work item it_fd9542a7; technical source work, no Plane card required. Operator procedure: ../guides/max-main-rollout.md. In the 0.13.1 backport use the authenticated owner API; its frontend has no MAX Settings button.</bpmn:documentation>
    <bpmn:laneSet id="Roles">
      <bpmn:lane id="OwnerLane" name="Host owner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Present</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GatewayLane" name="Gateway">
        <bpmn:flowNodeRef>Host</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Paired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denied</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Pair request" />
    <bpmn:userTask id="Request" name="Owner: request pair code" />
    <bpmn:exclusiveGateway id="Host" name="Host owner?" />
    <bpmn:serviceTask id="Issue" name="Gateway: issue code" />
    <bpmn:userTask id="Present" name="Owner: private /start" />
    <bpmn:exclusiveGateway id="Valid" name="Valid code?" />
    <bpmn:serviceTask id="Persist" name="Gateway: save numeric ID" />
    <bpmn:endEvent id="Paired" name="Paired" />
    <bpmn:endEvent id="Denied" name="Denied" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Request" name="" />
    <bpmn:sequenceFlow id="F2" sourceRef="Request" targetRef="Host" name="" />
    <bpmn:sequenceFlow id="F3" sourceRef="Host" targetRef="Issue" name="yes" />
    <bpmn:sequenceFlow id="F4" sourceRef="Host" targetRef="Denied" name="no" />
    <bpmn:sequenceFlow id="F5" sourceRef="Issue" targetRef="Present" name="" />
    <bpmn:sequenceFlow id="F6" sourceRef="Present" targetRef="Valid" name="" />
    <bpmn:sequenceFlow id="F7" sourceRef="Valid" targetRef="Persist" name="yes" />
    <bpmn:sequenceFlow id="F8" sourceRef="Valid" targetRef="Denied" name="expired / wrong / used" />
    <bpmn:sequenceFlow id="F9" sourceRef="Persist" targetRef="Paired" name="" />
  </bpmn:process>
