  <bpmn:process id="MaxConversation" name="MAX conversations and tool permission" isExecutable="false">
    <bpmn:documentation>Descriptive max.4 behavior. Owner-only private messages. Session/Bot pickers reuse Telegram common controller, scoped owner/message/nonce, atomic binding and rollback. Refuse stale selections; no implicit fallback to another conversation. Stop uses the original running key before reading persisted binding. Trust applies only to the current session under native policy; timeout denies after 300 seconds. No Camunda execution is claimed.</bpmn:documentation>
    <bpmn:startEvent id="ChatStart" name="Receive private update">
      <bpmn:outgoing>C01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="CheckOwner" name="Paired owner?">
      <bpmn:outgoing>C03</bpmn:outgoing>
      <bpmn:outgoing>C02</bpmn:outgoing>
      <bpmn:incoming>C01</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ChatDenied" name="Refuse">
      <bpmn:incoming>C02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CommandKind" name="Command?">
      <bpmn:outgoing>C14</bpmn:outgoing>
      <bpmn:outgoing>C12</bpmn:outgoing>
      <bpmn:outgoing>C10</bpmn:outgoing>
      <bpmn:outgoing>C08</bpmn:outgoing>
      <bpmn:outgoing>C04</bpmn:outgoing>
      <bpmn:incoming>C03</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ListChats" name="List /sessions or /bots">
      <bpmn:outgoing>C05</bpmn:outgoing>
      <bpmn:incoming>C04</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:userTask id="ChooseChat" name="Choose scoped button">
      <bpmn:outgoing>C06</bpmn:outgoing>
      <bpmn:incoming>C05</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="BindChat" name="Bind or report stale / error">
      <bpmn:outgoing>C07</bpmn:outgoing>
      <bpmn:incoming>C06</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ReleaseChat" name="Detach /new or /unlink">
      <bpmn:outgoing>C09</bpmn:outgoing>
      <bpmn:incoming>C08</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="StopChat" name="Cancel original /stop key">
      <bpmn:outgoing>C11</bpmn:outgoing>
      <bpmn:incoming>C10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="InfoChat" name="Show /help /agents /status">
      <bpmn:outgoing>C13</bpmn:outgoing>
      <bpmn:incoming>C12</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ChatReady" name="Ready for next message">
      <bpmn:incoming>C13</bpmn:incoming>
      <bpmn:incoming>C11</bpmn:incoming>
      <bpmn:incoming>C09</bpmn:incoming>
      <bpmn:incoming>C07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ResolveChat" name="Resolve bound context">
      <bpmn:outgoing>C26</bpmn:outgoing>
      <bpmn:outgoing>C15</bpmn:outgoing>
      <bpmn:incoming>C14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RunChat" name="Run model / native policy">
      <bpmn:outgoing>C16</bpmn:outgoing>
      <bpmn:incoming>C15</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NeedPermission" name="Permission needed?">
      <bpmn:outgoing>C19</bpmn:outgoing>
      <bpmn:outgoing>C17</bpmn:outgoing>
      <bpmn:incoming>C16</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SendReply" name="Send result">
      <bpmn:incoming>C26</bpmn:incoming>
      <bpmn:incoming>C25</bpmn:incoming>
      <bpmn:incoming>C22</bpmn:incoming>
      <bpmn:outgoing>C18</bpmn:outgoing>
      <bpmn:incoming>C17</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ChatDone" name="Delivered">
      <bpmn:incoming>C18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="WaitPermission" name="Owner replies 1 / 2 / 3">
      <bpmn:outgoing>C20</bpmn:outgoing>
      <bpmn:incoming>C19</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="ApprovalTimeout" name="300 sec" attachedToRef="WaitPermission" cancelActivity="true">
      <bpmn:outgoing>C24</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ApprovalTimer">
        <bpmn:timeDuration>PT300S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="DecisionKind" name="Owner decision?">
      <bpmn:outgoing>C23</bpmn:outgoing>
      <bpmn:outgoing>C21</bpmn:outgoing>
      <bpmn:incoming>C20</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AllowTool" name="Allow once / trust session">
      <bpmn:outgoing>C22</bpmn:outgoing>
      <bpmn:incoming>C21</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DenyTool" name="Deny tool">
      <bpmn:outgoing>C25</bpmn:outgoing>
      <bpmn:incoming>C24</bpmn:incoming>
      <bpmn:incoming>C23</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="C01" sourceRef="ChatStart" targetRef="CheckOwner" name="" />
    <bpmn:sequenceFlow id="C02" sourceRef="CheckOwner" targetRef="ChatDenied" name="no" />
    <bpmn:sequenceFlow id="C03" sourceRef="CheckOwner" targetRef="CommandKind" name="yes" />
    <bpmn:sequenceFlow id="C04" sourceRef="CommandKind" targetRef="ListChats" name="sessions / bots" />
    <bpmn:sequenceFlow id="C05" sourceRef="ListChats" targetRef="ChooseChat" name="" />
    <bpmn:sequenceFlow id="C06" sourceRef="ChooseChat" targetRef="BindChat" name="" />
    <bpmn:sequenceFlow id="C07" sourceRef="BindChat" targetRef="ChatReady" name="" />
    <bpmn:sequenceFlow id="C08" sourceRef="CommandKind" targetRef="ReleaseChat" name="new / unlink" />
    <bpmn:sequenceFlow id="C09" sourceRef="ReleaseChat" targetRef="ChatReady" name="" />
    <bpmn:sequenceFlow id="C10" sourceRef="CommandKind" targetRef="StopChat" name="stop" />
    <bpmn:sequenceFlow id="C11" sourceRef="StopChat" targetRef="ChatReady" name="" />
    <bpmn:sequenceFlow id="C12" sourceRef="CommandKind" targetRef="InfoChat" name="help / agents / status" />
    <bpmn:sequenceFlow id="C13" sourceRef="InfoChat" targetRef="ChatReady" name="" />
    <bpmn:sequenceFlow id="C14" sourceRef="CommandKind" targetRef="ResolveChat" name="text" />
    <bpmn:sequenceFlow id="C15" sourceRef="ResolveChat" targetRef="RunChat" name="valid binding" />
    <bpmn:sequenceFlow id="C16" sourceRef="RunChat" targetRef="NeedPermission" name="" />
    <bpmn:sequenceFlow id="C17" sourceRef="NeedPermission" targetRef="SendReply" name="no" />
    <bpmn:sequenceFlow id="C18" sourceRef="SendReply" targetRef="ChatDone" name="" />
    <bpmn:sequenceFlow id="C19" sourceRef="NeedPermission" targetRef="WaitPermission" name="yes" />
    <bpmn:sequenceFlow id="C20" sourceRef="WaitPermission" targetRef="DecisionKind" name="" />
    <bpmn:sequenceFlow id="C21" sourceRef="DecisionKind" targetRef="AllowTool" name="1 / 3" />
    <bpmn:sequenceFlow id="C22" sourceRef="AllowTool" targetRef="SendReply" name="native tool result" />
    <bpmn:sequenceFlow id="C23" sourceRef="DecisionKind" targetRef="DenyTool" name="2 / deny" />
    <bpmn:sequenceFlow id="C24" sourceRef="ApprovalTimeout" targetRef="DenyTool" name="timeout" />
    <bpmn:sequenceFlow id="C25" sourceRef="DenyTool" targetRef="SendReply" name="refusal" />
    <bpmn:sequenceFlow id="C26" sourceRef="ResolveChat" targetRef="SendReply" name="binding refusal" />
  </bpmn:process>
